{
  "expo": {
    "name": "PARTNER",
    "slug": "hdrssfrontent",
    "version": "1.2.6",
    "orientation": "portrait",
    "icon": "./assets/Header/partnerapp logo.jpeg",
    "scheme": "hdrss",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true,
      "buildNumber": "3"
    },

    "android": {
      "icon": "./assets/Header/partnerapp logo.jpeg",
      "adaptiveIcon": {
        "foregroundImage": "./assets/Header/partner-foreground.jpeg",
        "backgroundColor": "#A32311"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "package": "com.aktechnologies.hdrss",
      "versionCode": 13,
      "networkSecurityConfig": "./network_security_config.xml",
      "permissions": [
        "INTERNET",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },

    "web": {
      "favicon": "./assets/Header/partnerapp logo.jpeg"
    },

    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/Header/partnerapp logo.jpeg",
          "imageWidth": 200,
          "resizeMode": "cover",
          "backgroundColor": "#A32311",
          "dark": {
            "backgroundColor": "#A32311"
          }
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow $(PRODUCT_NAME) to access your calendar to set event reminders."
        }
      ],
      "expo-asset",
      "expo-video"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "eas": {
        "projectId": "5e8a1431-48c4-4a8d-b3fe-b34cd2788887"
      }
    }
  }
}